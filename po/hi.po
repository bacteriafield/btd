#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"उपयोग: btd [command] [options] [targets]\n"
"\n"
"कमांड:\n"
"  btd                        सिस्टम अपग्रेड करता है\n"
"  btd <term>                 आधिकारिक रिपॉज़िटरी और Copr में खोजता है, फिर इंस्टॉल करने के लिए चुनने देता है\n"
"  btd install|in|-i <pkg>    आधिकारिक रिपॉज़िटरी से इंस्टॉल करता है, न मिलने पर Copr से\n"
"  btd install owner/project/pkg\n"
"                             उस Copr प्रोजेक्ट से pkg इंस्टॉल करता है\n"
"  btd search|se|-s <term>    आधिकारिक रिपॉज़िटरी और Copr में खोजता है\n"
"  btd upgrade|up|-u          पैकेज अपग्रेड करता है\n"
"  btd remove|rm|-r <pkg>     पैकेज हटाता है\n"
"  btd <dnf command>          कोई भी अन्य dnf5 कमांड जैसी है वैसी आगे भेजी जाती है\n"
"\n"
"विकल्प:\n"
"  -h, --help                 यह सहायता दिखाता है\n"
"  --version                  btd का संस्करण दिखाता है\n"
"  -y, --assumeyes            btd और dnf के सवालों का जवाब हाँ देता है\n"
"  --save                     दिए गए विकल्पों को कॉन्फ़िग फ़ाइल में सहेजता है\n"
"  --copr-url <url>           Copr सर्वर\n"
"  --dnf-bin <path>           dnf5 बाइनरी\n"
"  --sudo-bin <path>          विशेषाधिकार उन्नयन टूल (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       विशेषाधिकार उन्नयन टूल के फ़्लैग\n"
"  --[no-]bottom-up           सबसे अच्छा मिलान सबसे अंत में, प्रॉम्प्ट के पास दिखाता है\n"
"  --[no-]single-line-results हर परिणाम एक पंक्ति में दिखाता है\n"
"  --[no-]debug               btd द्वारा चलाए गए कमांड और URL प्रिंट करता है\n"

