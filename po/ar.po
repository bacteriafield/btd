#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"الاستخدام: btd [command] [options] [targets]\n"
"\n"
"الأوامر:\n"
"  btd                        يرقّي النظام\n"
"  btd <term>                 يبحث في المستودعات الرسمية وCopr ثم يتيح اختيار ما يُثبَّت\n"
"  btd install|in|-i <pkg>    يثبّت من المستودعات الرسمية، أو من Copr عند عدم توفرها\n"
"  btd install owner/project/pkg\n"
"                             يثبّت pkg من مشروع Copr ذاك\n"
"  btd search|se|-s <term>    يبحث في المستودعات الرسمية وCopr\n"
"  btd upgrade|up|-u          يرقّي الحزم\n"
"  btd remove|rm|-r <pkg>     يزيل الحزم\n"
"  btd <dnf command>          يُمرَّر أي أمر آخر من أوامر dnf5 كما هو\n"
"\n"
"الخيارات:\n"
"  -h, --help                 يعرض هذه المساعدة\n"
"  --version                  يعرض إصدار btd\n"
"  -y, --assumeyes            يجيب بنعم على أسئلة btd وdnf\n"
"  --save                     يحفظ الخيارات المعطاة في ملف الإعدادات\n"
"  --copr-url <url>           خادم Copr\n"
"  --dnf-bin <path>           ملف dnf5 التنفيذي\n"
"  --sudo-bin <path>          أداة رفع الصلاحيات (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       خيارات أداة رفع الصلاحيات\n"
"  --[no-]bottom-up           يعرض أفضل نتيجة في الأخير، بجوار المحث\n"
"  --[no-]single-line-results يعرض كل نتيجة في سطر واحد\n"
"  --[no-]debug               يطبع الأوامر وعناوين URL التي يشغّلها btd\n"

