#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"brug: btd [command] [options] [targets]\n"
"\n"
"kommandoer:\n"
"  btd                        opgraderer systemet\n"
"  btd <term>                 søger i officielle depoter og Copr og vælger, hvad der skal installeres\n"
"  btd install|in|-i <pkg>    installerer fra officielle depoter, med Copr som reserve\n"
"  btd install owner/project/pkg\n"
"                             installerer pkg fra det Copr-projekt\n"
"  btd search|se|-s <term>    søger i officielle depoter og Copr\n"
"  btd upgrade|up|-u          opgraderer pakker\n"
"  btd remove|rm|-r <pkg>     fjerner pakker\n"
"  btd <dnf command>          alle andre dnf5-kommandoer sendes videre\n"
"\n"
"tilvalg:\n"
"  -h, --help                 viser denne hjælp\n"
"  --version                  viser btd's version\n"
"  -y, --assumeyes            svarer ja til spørgsmål fra btd og dnf\n"
"  --save                     gemmer de angivne tilvalg i konfigurationsfilen\n"
"  --copr-url <url>           Copr-server\n"
"  --dnf-bin <path>           dnf5-program\n"
"  --sudo-bin <path>          værktøj til rettighedsforøgelse (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flag til værktøjet til rettighedsforøgelse\n"
"  --[no-]bottom-up           viser det bedste match sidst, ved prompten\n"
"  --[no-]single-line-results viser hvert resultat på én linje\n"
"  --[no-]debug               udskriver de kommandoer og URL'er, btd kører\n"

