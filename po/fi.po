#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"käyttö: btd [command] [options] [targets]\n"
"\n"
"komennot:\n"
"  btd                        päivittää järjestelmän\n"
"  btd <term>                 hakee virallisista lähteistä ja Coprista ja valitsee asennettavat\n"
"  btd install|in|-i <pkg>    asentaa virallisista lähteistä, tarvittaessa Coprista\n"
"  btd install owner/project/pkg\n"
"                             asentaa pkg:n kyseisestä Copr-projektista\n"
"  btd search|se|-s <term>    hakee virallisista lähteistä ja Coprista\n"
"  btd upgrade|up|-u          päivittää paketit\n"
"  btd remove|rm|-r <pkg>     poistaa paketit\n"
"  btd <dnf command>          muut dnf5-komennot välitetään sellaisenaan\n"
"\n"
"valitsimet:\n"
"  -h, --help                 näyttää tämän ohjeen\n"
"  --version                  näyttää btd:n version\n"
"  -y, --assumeyes            vastaa kyllä btd:n ja dnf:n kysymyksiin\n"
"  --save                     tallentaa annetut valitsimet asetustiedostoon\n"
"  --copr-url <url>           Copr-palvelin\n"
"  --dnf-bin <path>           dnf5-ohjelma\n"
"  --sudo-bin <path>          oikeuksien korotustyökalu (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       oikeuksien korotustyökalun valitsimet\n"
"  --[no-]bottom-up           näyttää parhaan osuman viimeisenä, kehotteen vieressä\n"
"  --[no-]single-line-results näyttää jokaisen tuloksen yhdellä rivillä\n"
"  --[no-]debug               tulostaa btd:n suorittamat komennot ja URL-osoitteet\n"

