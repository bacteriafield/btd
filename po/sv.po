#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"användning: btd [command] [options] [targets]\n"
"\n"
"kommandon:\n"
"  btd                        uppgraderar systemet\n"
"  btd <term>                 söker i officiella förråd och Copr och väljer vad som ska installeras\n"
"  btd install|in|-i <pkg>    installerar från officiella förråd, med Copr som reserv\n"
"  btd install owner/project/pkg\n"
"                             installerar pkg från det Copr-projektet\n"
"  btd search|se|-s <term>    söker i officiella förråd och Copr\n"
"  btd upgrade|up|-u          uppgraderar paket\n"
"  btd remove|rm|-r <pkg>     tar bort paket\n"
"  btd <dnf command>          alla andra dnf5-kommandon skickas vidare\n"
"\n"
"flaggor:\n"
"  -h, --help                 visar denna hjälp\n"
"  --version                  visar btd:s version\n"
"  -y, --assumeyes            svarar ja på frågor från btd och dnf\n"
"  --save                     sparar de angivna flaggorna i konfigurationsfilen\n"
"  --copr-url <url>           Copr-server\n"
"  --dnf-bin <path>           dnf5-program\n"
"  --sudo-bin <path>          verktyg för behörighetshöjning (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flaggor för verktyget för behörighetshöjning\n"
"  --[no-]bottom-up           visar bästa träffen sist, närmast prompten\n"
"  --[no-]single-line-results visar varje resultat på en rad\n"
"  --[no-]debug               skriver ut kommandon och URL:er som btd kör\n"

