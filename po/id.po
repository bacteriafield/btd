#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"penggunaan: btd [command] [options] [targets]\n"
"\n"
"perintah:\n"
"  btd                        memperbarui sistem\n"
"  btd <term>                 mencari di repositori resmi dan Copr, lalu memilih yang akan dipasang\n"
"  btd install|in|-i <pkg>    memasang dari repositori resmi, atau dari Copr bila tidak ada\n"
"  btd install owner/project/pkg\n"
"                             memasang pkg dari proyek Copr tersebut\n"
"  btd search|se|-s <term>    mencari di repositori resmi dan Copr\n"
"  btd upgrade|up|-u          memperbarui paket\n"
"  btd remove|rm|-r <pkg>     menghapus paket\n"
"  btd <dnf command>          perintah dnf5 lainnya diteruskan apa adanya\n"
"\n"
"opsi:\n"
"  -h, --help                 menampilkan bantuan ini\n"
"  --version                  menampilkan versi btd\n"
"  -y, --assumeyes            menjawab ya untuk pertanyaan btd dan dnf\n"
"  --save                     menyimpan opsi yang diberikan ke berkas konfigurasi\n"
"  --copr-url <url>           server Copr\n"
"  --dnf-bin <path>           program dnf5\n"
"  --sudo-bin <path>          alat peningkatan hak akses (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       opsi untuk alat peningkatan hak akses\n"
"  --[no-]bottom-up           menampilkan hasil terbaik paling akhir, di dekat prompt\n"
"  --[no-]single-line-results menampilkan setiap hasil dalam satu baris\n"
"  --[no-]debug               mencetak perintah dan URL yang dijalankan btd\n"

