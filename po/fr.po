#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"utilisation : btd [command] [options] [targets]\n"
"\n"
"commandes :\n"
"  btd                        met à jour le système\n"
"  btd <term>                 cherche dans les dépôts officiels et Copr, puis choisit quoi installer\n"
"  btd install|in|-i <pkg>    installe depuis les dépôts officiels, sinon depuis Copr\n"
"  btd install owner/project/pkg\n"
"                             installe pkg depuis ce projet Copr\n"
"  btd search|se|-s <term>    cherche dans les dépôts officiels et Copr\n"
"  btd upgrade|up|-u          met à jour des paquets\n"
"  btd remove|rm|-r <pkg>     supprime des paquets\n"
"  btd <dnf command>          toute autre commande dnf5 est transmise telle quelle\n"
"\n"
"options :\n"
"  -h, --help                 affiche cette aide\n"
"  --version                  affiche la version de btd\n"
"  -y, --assumeyes            répond oui aux questions de btd et dnf\n"
"  --save                     enregistre les options données dans le fichier de configuration\n"
"  --copr-url <url>           serveur Copr\n"
"  --dnf-bin <path>           binaire dnf5\n"
"  --sudo-bin <path>          outil d'élévation de privilèges (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       options de l'outil d'élévation de privilèges\n"
"  --[no-]bottom-up           affiche le meilleur résultat en dernier, près de l'invite\n"
"  --[no-]single-line-results affiche chaque résultat sur une ligne\n"
"  --[no-]debug               affiche les commandes et URL exécutées par btd\n"

