#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"utilização: btd [command] [options] [targets]\n"
"\n"
"comandos:\n"
"  btd                        atualiza o sistema\n"
"  btd <term>                 pesquisa nos repositórios oficiais e no Copr e escolhe o que instalar\n"
"  btd install|in|-i <pkg>    instala a partir dos repositórios oficiais, recorrendo ao Copr\n"
"  btd install owner/project/pkg\n"
"                             instala pkg desse projeto Copr\n"
"  btd search|se|-s <term>    pesquisa nos repositórios oficiais e no Copr\n"
"  btd upgrade|up|-u          atualiza pacotes\n"
"  btd remove|rm|-r <pkg>     remove pacotes\n"
"  btd <dnf command>          qualquer outro comando do dnf5 é reencaminhado\n"
"\n"
"opções:\n"
"  -h, --help                 mostra esta ajuda\n"
"  --version                  mostra a versão do btd\n"
"  -y, --assumeyes            responde sim às perguntas do btd e do dnf\n"
"  --save                     guarda as opções indicadas no ficheiro de configuração\n"
"  --copr-url <url>           servidor Copr\n"
"  --dnf-bin <path>           binário do dnf5\n"
"  --sudo-bin <path>          ferramenta de elevação de privilégios (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       opções da ferramenta de elevação de privilégios\n"
"  --[no-]bottom-up           mostra o melhor resultado em último, junto ao prompt\n"
"  --[no-]single-line-results mostra cada resultado numa linha\n"
"  --[no-]debug               mostra os comandos e URLs que o btd executa\n"

