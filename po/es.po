#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"uso: btd [command] [options] [targets]\n"
"\n"
"comandos:\n"
"  btd                        actualiza el sistema\n"
"  btd <term>                 busca en los repositorios oficiales y en Copr, y elige qué instalar\n"
"  btd install|in|-i <pkg>    instala desde los repositorios oficiales, recurriendo a Copr\n"
"  btd install owner/project/pkg\n"
"                             instala pkg desde ese proyecto Copr\n"
"  btd search|se|-s <term>    busca en los repositorios oficiales y en Copr\n"
"  btd upgrade|up|-u          actualiza paquetes\n"
"  btd remove|rm|-r <pkg>     elimina paquetes\n"
"  btd <dnf command>          cualquier otro comando de dnf5 se pasa tal cual\n"
"\n"
"opciones:\n"
"  -h, --help                 muestra esta ayuda\n"
"  --version                  muestra la versión de btd\n"
"  -y, --assumeyes            responde sí a las preguntas de btd y dnf\n"
"  --save                     guarda las opciones indicadas en el archivo de configuración\n"
"  --copr-url <url>           servidor Copr\n"
"  --dnf-bin <path>           binario de dnf5\n"
"  --sudo-bin <path>          herramienta de elevación de privilegios (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       opciones de la herramienta de elevación de privilegios\n"
"  --[no-]bottom-up           muestra la mejor coincidencia al final, junto al prompt\n"
"  --[no-]single-line-results muestra cada resultado en una línea\n"
"  --[no-]debug               muestra los comandos y URLs que ejecuta btd\n"

