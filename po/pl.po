#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"użycie: btd [command] [options] [targets]\n"
"\n"
"polecenia:\n"
"  btd                        aktualizuje system\n"
"  btd <term>                 przeszukuje oficjalne repozytoria i Copr, a potem pozwala wybrać, co zainstalować\n"
"  btd install|in|-i <pkg>    instaluje z oficjalnych repozytoriów, a w razie braku z Copr\n"
"  btd install owner/project/pkg\n"
"                             instaluje pkg z tego projektu Copr\n"
"  btd search|se|-s <term>    przeszukuje oficjalne repozytoria i Copr\n"
"  btd upgrade|up|-u          aktualizuje pakiety\n"
"  btd remove|rm|-r <pkg>     usuwa pakiety\n"
"  btd <dnf command>          każde inne polecenie dnf5 jest przekazywane dalej\n"
"\n"
"opcje:\n"
"  -h, --help                 wyświetla tę pomoc\n"
"  --version                  wyświetla wersję btd\n"
"  -y, --assumeyes            odpowiada tak na pytania btd i dnf\n"
"  --save                     zapisuje podane opcje w pliku konfiguracyjnym\n"
"  --copr-url <url>           serwer Copr\n"
"  --dnf-bin <path>           plik wykonywalny dnf5\n"
"  --sudo-bin <path>          narzędzie do podnoszenia uprawnień (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       opcje narzędzia do podnoszenia uprawnień\n"
"  --[no-]bottom-up           pokazuje najlepsze dopasowanie na końcu, tuż nad monitem\n"
"  --[no-]single-line-results pokazuje każdy wynik w jednym wierszu\n"
"  --[no-]debug               wypisuje polecenia i adresy URL uruchamiane przez btd\n"

