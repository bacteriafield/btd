#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"використання: btd [command] [options] [targets]\n"
"\n"
"команди:\n"
"  btd                        оновлює систему\n"
"  btd <term>                 шукає в офіційних репозиторіях і Copr, потім дає вибрати, що встановити\n"
"  btd install|in|-i <pkg>    встановлює з офіційних репозиторіїв, інакше з Copr\n"
"  btd install owner/project/pkg\n"
"                             встановлює pkg з цього проєкту Copr\n"
"  btd search|se|-s <term>    шукає в офіційних репозиторіях і Copr\n"
"  btd upgrade|up|-u          оновлює пакунки\n"
"  btd remove|rm|-r <pkg>     вилучає пакунки\n"
"  btd <dnf command>          будь-яка інша команда dnf5 передається як є\n"
"\n"
"параметри:\n"
"  -h, --help                 показує цю довідку\n"
"  --version                  показує версію btd\n"
"  -y, --assumeyes            відповідає «так» на запитання btd і dnf\n"
"  --save                     зберігає вказані параметри у файл налаштувань\n"
"  --copr-url <url>           сервер Copr\n"
"  --dnf-bin <path>           виконуваний файл dnf5\n"
"  --sudo-bin <path>          засіб підвищення привілеїв (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       прапорці засобу підвищення привілеїв\n"
"  --[no-]bottom-up           показує найкращий збіг останнім, біля запрошення\n"
"  --[no-]single-line-results показує кожен результат в одному рядку\n"
"  --[no-]debug               виводить команди та URL, які запускає btd\n"

