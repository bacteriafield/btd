#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"használat: btd [command] [options] [targets]\n"
"\n"
"parancsok:\n"
"  btd                        frissíti a rendszert\n"
"  btd <term>                 keres a hivatalos tárolókban és a Coprban, majd kiválasztható a telepítendő\n"
"  btd install|in|-i <pkg>    telepít a hivatalos tárolókból, szükség esetén a Coprból\n"
"  btd install owner/project/pkg\n"
"                             telepíti a pkg-t abból a Copr-projektből\n"
"  btd search|se|-s <term>    keres a hivatalos tárolókban és a Coprban\n"
"  btd upgrade|up|-u          frissíti a csomagokat\n"
"  btd remove|rm|-r <pkg>     eltávolítja a csomagokat\n"
"  btd <dnf command>          minden más dnf5-parancs változatlanul továbbítódik\n"
"\n"
"kapcsolók:\n"
"  -h, --help                 megjeleníti ezt a súgót\n"
"  --version                  megjeleníti a btd verzióját\n"
"  -y, --assumeyes            igennel válaszol a btd és a dnf kérdéseire\n"
"  --save                     elmenti a megadott kapcsolókat a konfigurációs fájlba\n"
"  --copr-url <url>           Copr-kiszolgáló\n"
"  --dnf-bin <path>           dnf5 program\n"
"  --sudo-bin <path>          jogosultság-emelő eszköz (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       a jogosultság-emelő eszköz kapcsolói\n"
"  --[no-]bottom-up           a legjobb találatot utolsóként, a prompt mellett mutatja\n"
"  --[no-]single-line-results minden találatot egy sorban mutat\n"
"  --[no-]debug               kiírja a btd által futtatott parancsokat és URL-eket\n"

