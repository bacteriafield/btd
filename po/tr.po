#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"kullanım: btd [command] [options] [targets]\n"
"\n"
"komutlar:\n"
"  btd                        sistemi yükseltir\n"
"  btd <term>                 resmi depolarda ve Copr'da arar, ardından kurulacakları seçtirir\n"
"  btd install|in|-i <pkg>    resmi depolardan, yoksa Copr'dan kurar\n"
"  btd install owner/project/pkg\n"
"                             pkg'yi o Copr projesinden kurar\n"
"  btd search|se|-s <term>    resmi depolarda ve Copr'da arar\n"
"  btd upgrade|up|-u          paketleri yükseltir\n"
"  btd remove|rm|-r <pkg>     paketleri kaldırır\n"
"  btd <dnf command>          diğer tüm dnf5 komutları olduğu gibi iletilir\n"
"\n"
"seçenekler:\n"
"  -h, --help                 bu yardımı gösterir\n"
"  --version                  btd sürümünü gösterir\n"
"  -y, --assumeyes            btd ve dnf sorularına evet yanıtı verir\n"
"  --save                     verilen seçenekleri yapılandırma dosyasına kaydeder\n"
"  --copr-url <url>           Copr sunucusu\n"
"  --dnf-bin <path>           dnf5 programı\n"
"  --sudo-bin <path>          yetki yükseltme aracı (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       yetki yükseltme aracının seçenekleri\n"
"  --[no-]bottom-up           en iyi eşleşmeyi en sonda, istemin yanında gösterir\n"
"  --[no-]single-line-results her sonucu tek satırda gösterir\n"
"  --[no-]debug               btd'nin çalıştırdığı komutları ve URL'leri yazdırır\n"

