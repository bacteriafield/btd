#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"uso: btd [command] [options] [targets]\n"
"\n"
"comandi:\n"
"  btd                        aggiorna il sistema\n"
"  btd <term>                 cerca nei repository ufficiali e in Copr, poi scegli cosa installare\n"
"  btd install|in|-i <pkg>    installa dai repository ufficiali, ripiegando su Copr\n"
"  btd install owner/project/pkg\n"
"                             installa pkg da quel progetto Copr\n"
"  btd search|se|-s <term>    cerca nei repository ufficiali e in Copr\n"
"  btd upgrade|up|-u          aggiorna i pacchetti\n"
"  btd remove|rm|-r <pkg>     rimuove i pacchetti\n"
"  btd <dnf command>          qualsiasi altro comando dnf5 viene inoltrato\n"
"\n"
"opzioni:\n"
"  -h, --help                 mostra questo aiuto\n"
"  --version                  mostra la versione di btd\n"
"  -y, --assumeyes            risponde sì alle domande di btd e dnf\n"
"  --save                     salva le opzioni indicate nel file di configurazione\n"
"  --copr-url <url>           server Copr\n"
"  --dnf-bin <path>           binario di dnf5\n"
"  --sudo-bin <path>          strumento di elevazione dei privilegi (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       opzioni per lo strumento di elevazione dei privilegi\n"
"  --[no-]bottom-up           mostra il risultato migliore per ultimo, vicino al prompt\n"
"  --[no-]single-line-results mostra ogni risultato su una riga\n"
"  --[no-]debug               stampa i comandi e gli URL eseguiti da btd\n"

