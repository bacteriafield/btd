#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"použití: btd [command] [options] [targets]\n"
"\n"
"příkazy:\n"
"  btd                        aktualizuje systém\n"
"  btd <term>                 prohledá oficiální repozitáře a Copr a nechá vybrat, co nainstalovat\n"
"  btd install|in|-i <pkg>    instaluje z oficiálních repozitářů, jinak z Copr\n"
"  btd install owner/project/pkg\n"
"                             nainstaluje pkg z daného projektu Copr\n"
"  btd search|se|-s <term>    prohledá oficiální repozitáře a Copr\n"
"  btd upgrade|up|-u          aktualizuje balíčky\n"
"  btd remove|rm|-r <pkg>     odstraní balíčky\n"
"  btd <dnf command>          jakýkoli jiný příkaz dnf5 se předá dál\n"
"\n"
"přepínače:\n"
"  -h, --help                 zobrazí tuto nápovědu\n"
"  --version                  zobrazí verzi btd\n"
"  -y, --assumeyes            odpoví ano na otázky btd a dnf\n"
"  --save                     uloží zadané přepínače do konfiguračního souboru\n"
"  --copr-url <url>           server Copr\n"
"  --dnf-bin <path>           program dnf5\n"
"  --sudo-bin <path>          nástroj pro zvýšení oprávnění (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       přepínače nástroje pro zvýšení oprávnění\n"
"  --[no-]bottom-up           zobrazí nejlepší shodu jako poslední, u výzvy\n"
"  --[no-]single-line-results zobrazí každý výsledek na jednom řádku\n"
"  --[no-]debug               vypíše příkazy a URL, které btd spouští\n"

