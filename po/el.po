#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"χρήση: btd [command] [options] [targets]\n"
"\n"
"εντολές:\n"
"  btd                        αναβαθμίζει το σύστημα\n"
"  btd <term>                 αναζητά στα επίσημα αποθετήρια και στο Copr και σας αφήνει να επιλέξετε τι θα εγκατασταθεί\n"
"  btd install|in|-i <pkg>    εγκαθιστά από τα επίσημα αποθετήρια, αλλιώς από το Copr\n"
"  btd install owner/project/pkg\n"
"                             εγκαθιστά το pkg από αυτό το έργο Copr\n"
"  btd search|se|-s <term>    αναζητά στα επίσημα αποθετήρια και στο Copr\n"
"  btd upgrade|up|-u          αναβαθμίζει πακέτα\n"
"  btd remove|rm|-r <pkg>     αφαιρεί πακέτα\n"
"  btd <dnf command>          κάθε άλλη εντολή του dnf5 προωθείται αυτούσια\n"
"\n"
"επιλογές:\n"
"  -h, --help                 εμφανίζει αυτή τη βοήθεια\n"
"  --version                  εμφανίζει την έκδοση του btd\n"
"  -y, --assumeyes            απαντά ναι στις ερωτήσεις του btd και του dnf\n"
"  --save                     αποθηκεύει τις δοσμένες επιλογές στο αρχείο ρυθμίσεων\n"
"  --copr-url <url>           διακομιστής Copr\n"
"  --dnf-bin <path>           εκτελέσιμο του dnf5\n"
"  --sudo-bin <path>          εργαλείο ανύψωσης δικαιωμάτων (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       επιλογές για το εργαλείο ανύψωσης δικαιωμάτων\n"
"  --[no-]bottom-up           εμφανίζει την καλύτερη αντιστοιχία τελευταία, δίπλα στην προτροπή\n"
"  --[no-]single-line-results εμφανίζει κάθε αποτέλεσμα σε μία γραμμή\n"
"  --[no-]debug               εμφανίζει τις εντολές και τα URL που εκτελεί το btd\n"

