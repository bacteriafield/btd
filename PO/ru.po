#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"использование: btd [command] [options] [targets]\n"
"\n"
"команды:\n"
"  btd                        обновляет систему\n"
"  btd <term>                 ищет в официальных репозиториях и Copr, затем позволяет выбрать, что установить\n"
"  btd install|in|-i <pkg>    устанавливает из официальных репозиториев, иначе из Copr\n"
"  btd install owner/project/pkg\n"
"                             устанавливает pkg из этого проекта Copr\n"
"  btd search|se|-s <term>    ищет в официальных репозиториях и Copr\n"
"  btd upgrade|up|-u          обновляет пакеты\n"
"  btd remove|rm|-r <pkg>     удаляет пакеты\n"
"  btd <dnf command>          любая другая команда dnf5 передаётся как есть\n"
"\n"
"параметры:\n"
"  -h, --help                 показывает эту справку\n"
"  --version                  показывает версию btd\n"
"  -y, --assumeyes            отвечает «да» на вопросы btd и dnf\n"
"  --save                     сохраняет указанные параметры в файл конфигурации\n"
"  --copr-url <url>           сервер Copr\n"
"  --dnf-bin <path>           исполняемый файл dnf5\n"
"  --sudo-bin <path>          средство повышения привилегий (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       флаги средства повышения привилегий\n"
"  --[no-]bottom-up           показывает лучшее совпадение последним, рядом с приглашением\n"
"  --[no-]single-line-results показывает каждый результат в одной строке\n"
"  --[no-]debug               выводит команды и URL, которые запускает btd\n"

