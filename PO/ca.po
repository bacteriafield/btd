#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"ús: btd [command] [options] [targets]\n"
"\n"
"ordres:\n"
"  btd                        actualitza el sistema\n"
"  btd <term>                 cerca als repositoris oficials i a Copr, i tria què instal·lar\n"
"  btd install|in|-i <pkg>    instal·la des dels repositoris oficials, recorrent a Copr\n"
"  btd install owner/project/pkg\n"
"                             instal·la pkg des d'aquest projecte Copr\n"
"  btd search|se|-s <term>    cerca als repositoris oficials i a Copr\n"
"  btd upgrade|up|-u          actualitza paquets\n"
"  btd remove|rm|-r <pkg>     elimina paquets\n"
"  btd <dnf command>          qualsevol altra ordre de dnf5 es passa directament\n"
"\n"
"opcions:\n"
"  -h, --help                 mostra aquesta ajuda\n"
"  --version                  mostra la versió de btd\n"
"  -y, --assumeyes            respon sí a les preguntes de btd i dnf\n"
"  --save                     desa les opcions indicades al fitxer de configuració\n"
"  --copr-url <url>           servidor Copr\n"
"  --dnf-bin <path>           binari de dnf5\n"
"  --sudo-bin <path>          eina d'elevació de privilegis (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       opcions de l'eina d'elevació de privilegis\n"
"  --[no-]bottom-up           mostra la millor coincidència al final, al costat de l'indicador\n"
"  --[no-]single-line-results mostra cada resultat en una línia\n"
"  --[no-]debug               mostra les ordres i URL que executa btd\n"

