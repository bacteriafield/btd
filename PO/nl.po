#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"gebruik: btd [command] [options] [targets]\n"
"\n"
"opdrachten:\n"
"  btd                        werkt het systeem bij\n"
"  btd <term>                 doorzoekt officiële repository's en Copr en kiest wat te installeren\n"
"  btd install|in|-i <pkg>    installeert uit officiële repository's, met Copr als terugval\n"
"  btd install owner/project/pkg\n"
"                             installeert pkg uit dat Copr-project\n"
"  btd search|se|-s <term>    doorzoekt officiële repository's en Copr\n"
"  btd upgrade|up|-u          werkt pakketten bij\n"
"  btd remove|rm|-r <pkg>     verwijdert pakketten\n"
"  btd <dnf command>          elke andere dnf5-opdracht wordt doorgegeven\n"
"\n"
"opties:\n"
"  -h, --help                 toont deze hulp\n"
"  --version                  toont de versie van btd\n"
"  -y, --assumeyes            beantwoordt vragen van btd en dnf met ja\n"
"  --save                     slaat de opgegeven opties op in het configuratiebestand\n"
"  --copr-url <url>           Copr-server\n"
"  --dnf-bin <path>           dnf5-programma\n"
"  --sudo-bin <path>          hulpmiddel voor rechtenverhoging (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       opties voor het hulpmiddel voor rechtenverhoging\n"
"  --[no-]bottom-up           toont de beste overeenkomst als laatste, vlak boven de prompt\n"
"  --[no-]single-line-results toont elk resultaat op één regel\n"
"  --[no-]debug               toont de opdrachten en URL's die btd uitvoert\n"

