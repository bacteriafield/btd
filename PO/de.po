#: main.go:532
msgid ""
"usage: btd [command] [options] [targets]\n"
"\n"
"commands:\n"
"  btd                        upgrade the system\n"
"  btd <term>                 search official repos and Copr, then pick what to install\n"
"  btd install|in|-i <pkg>    install from official repos, falling back to Copr\n"
"  btd install owner/project/pkg\n"
"                             install pkg from that Copr project\n"
"  btd search|se|-s <term>    search official repos and Copr\n"
"  btd upgrade|up|-u          upgrade packages\n"
"  btd remove|rm|-r <pkg>     remove packages\n"
"  btd <dnf command>          any other dnf5 command is passed through\n"
"\n"
"options:\n"
"  -h, --help                 show this help\n"
"  --version                  show btd's version\n"
"  -y, --assumeyes            answer yes to btd and dnf questions\n"
"  --save                     save the given options to the config file\n"
"  --copr-url <url>           Copr server\n"
"  --dnf-bin <path>           dnf5 binary\n"
"  --sudo-bin <path>          privilege elevator (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       flags for the privilege elevator\n"
"  --[no-]bottom-up           show the best match last, next to the prompt\n"
"  --[no-]single-line-results show each result on one line\n"
"  --[no-]debug               print the commands and URLs btd runs\n"
msgstr ""
"Verwendung: btd [command] [options] [targets]\n"
"\n"
"Befehle:\n"
"  btd                        aktualisiert das System\n"
"  btd <term>                 durchsucht offizielle Repositorys und Copr und wählt aus, was installiert wird\n"
"  btd install|in|-i <pkg>    installiert aus offiziellen Repositorys, sonst aus Copr\n"
"  btd install owner/project/pkg\n"
"                             installiert pkg aus diesem Copr-Projekt\n"
"  btd search|se|-s <term>    durchsucht offizielle Repositorys und Copr\n"
"  btd upgrade|up|-u          aktualisiert Pakete\n"
"  btd remove|rm|-r <pkg>     entfernt Pakete\n"
"  btd <dnf command>          jeder andere dnf5-Befehl wird durchgereicht\n"
"\n"
"Optionen:\n"
"  -h, --help                 zeigt diese Hilfe\n"
"  --version                  zeigt die Version von btd\n"
"  -y, --assumeyes            beantwortet Fragen von btd und dnf mit Ja\n"
"  --save                     speichert die angegebenen Optionen in der Konfigurationsdatei\n"
"  --copr-url <url>           Copr-Server\n"
"  --dnf-bin <path>           dnf5-Programm\n"
"  --sudo-bin <path>          Werkzeug zur Rechteerhöhung (sudo, run0, doas, pkexec)\n"
"  --sudo-flags <flags>       Optionen für das Werkzeug zur Rechteerhöhung\n"
"  --[no-]bottom-up           zeigt den besten Treffer zuletzt, direkt über der Eingabe\n"
"  --[no-]single-line-results zeigt jedes Ergebnis in einer Zeile\n"
"  --[no-]debug               gibt die Befehle und URLs aus, die btd ausführt\n"

